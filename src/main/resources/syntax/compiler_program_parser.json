{
    "type": "compiler_parser_rules",

    "package": "xlang.compiler.parser",
    "class": "Parser",
    "imports": [
        "xlang.Diagnostic",
        "xlang.Diagnostics",
        "xlang.compiler.lexer.Tokenizer",
        "xlang.lexer.Token",
        "xlang.compiler.parser.expression.Atom",
        "xlang.compiler.parser.expression.Expression",
        "xlang.compiler.parser.program.Annotation",
        "xlang.compiler.parser.program.Field",
        "xlang.compiler.parser.program.Function",
        "xlang.compiler.parser.program.FunctionParam",
        "xlang.compiler.parser.program.FunctionParams",
        "xlang.compiler.parser.program.Member",
        "xlang.compiler.parser.program.Struct",
        "xlang.compiler.parser.program.StructConstructor",
        "xlang.compiler.parser.program.PreprocessSetting",
        "xlang.compiler.parser.program.Program",
        "xlang.compiler.parser.program.ImportDeclaration",
        "xlang.compiler.parser.program.ImportedSymbol",
        "xlang.compiler.parser.program.NamespaceImport",
        "xlang.compiler.parser.program.Modifier",
        "xlang.compiler.parser.program.PackageDeclaration",
        "xlang.compiler.parser.program.QualifiedName",
        "xlang.compiler.parser.program.SelectiveImports",
        "xlang.compiler.parser.stmtexpr.Block",
        "xlang.lexer.TokenizedFile",
        "xlang.parser.ASTFile",
        "xlang.parser.Parser",
        "xlang.parser.ParserResult",
        "xlang.parser.pratt.PrattParser",
        "xlang.util.HashSet"
    ],
    "constants": [

    ],
    "patterns": [
        
    ],
    "rules": [
        {
            "class": "Modifier",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.KW_PRIVATE" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_PROTECTED" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_PUBLIC" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_STATIC" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_FINAL" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_INLINE" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_NATIVE" }], "action": "makeModifier" },
                { "patterns": [{ "kind": "Tokenizer.KW_INTRINSIC" }], "action": "makeModifier" }
            ]
        },
        {
            "class": "ModifierList",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "[$Modifier]" }], "action": "makeModifierList" }
            ]
        },
        {
            "class": "PreprocessSetting",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.HASH" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.LEFT_PAREN" },  { "kind": "#Atoms" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makePreprocessSetting" }
            ]
        },
        {
            "class": "Annotation",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.AT" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "#Atoms" }, { "kind": "Tokenizer.RIGHT_PAREN" }], "action": "makeAnnotationWithValues" },
                { "patterns": [{ "kind": "Tokenizer.AT" }, { "kind": "$QualifiedName" }], "action": "makeAnnotation" }
            ]
        },
        {
            "class": "Annotations",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "[$Annotation]" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeAnnotations" }
            ]
        },
        {
            "class": "QualifiedName",
            "parser": "recursively-down",
            "sub_rules": [{"patterns": [{ "kind": "Tokenizer.TK_IDENTIFIER" }, {"loop": [{ "kind": "Tokenizer.DOT" }, { "kind": "Tokenizer.TK_IDENTIFIER" }]}], "action": "makeQualifiedName" }]
        },
        {
            "class": "PackageDeclaration",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.KW_PACKAGE" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makePackageDeclaration" }
            ]
        },
        {
            "class": "NamespaceImport",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.KW_IMPORT" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.DOT" }, { "kind": "Tokenizer.STAR" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeAllNamespaceImport" },
                { "patterns": [{ "kind": "Tokenizer.KW_IMPORT" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeNamespaceImport" }
            ]
        },
        {
            "class": "ImportedSymbolAlias",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.KW_AS" }, { "kind": "Tokenizer.TK_IDENTIFIER" }], "action": "makeImportedSymbolAlias" }
            ]
        },
        {
            "class": "ImportedSymbol",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "[$Type]", "split_by": { "kind": "Tokenizer.COMMA" } }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "maybe_kind": "$ImportedSymbolAlias" }], "action": "makeImportedFunction" },
                { "patterns": [{ "kind": "Tokenizer.TK_IDENTIFIER" }, { "maybe_kind": "$ImportedSymbolAlias" }], "action": "makeImportedVariable" }
            ]
        },
        {
            "class": "SelectiveImports",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.KW_FROM" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.KW_IMPORT" }, { "kind": "Tokenizer.STAR" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeAllSelectiveImport" },
                { "patterns": [{ "kind": "Tokenizer.KW_FROM" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.KW_IMPORT" }, { "kind": "Tokenizer.LEFT_BRACE" }, { "kind": "[$ImportedSymbol]", "split_by": { "kind": "Tokenizer.COMMA" } }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }, { "kind": "Tokenizer.RIGHT_BRACE" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeSelectiveImports" },
                { "patterns": [{ "kind": "Tokenizer.KW_FROM" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.KW_IMPORT" }, { "kind": "Tokenizer.LEFT_BRACE" }, { "kind": "[$ImportedSymbol]", "split_by": { "kind": "Tokenizer.COMMA" } }, { "kind": "Tokenizer.RIGHT_BRACE" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeSelectiveImports" },
                { "patterns": [{ "kind": "Tokenizer.KW_FROM" }, { "kind": "$QualifiedName" }, { "kind": "Tokenizer.KW_IMPORT" }, { "kind": "$ImportedSymbol" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeSelectiveImport" }
            ]
        },
        {
            "class": "ImportDeclaration",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "$NamespaceImport" }], "action": "makeImportFromNamespace" },
                { "patterns": [{ "kind": "$SelectiveImports" }], "action": "makeImportFromSelective" }
            ]
        },
        {
            "class": "ImportDeclarations",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "[$ImportDeclaration]" }], "action": "makeImportDeclarations" }
            ]
        },
        {
            "class": "FunctionParam",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Type" }], "action": "makeFunctionParam" },
                { "patterns": [{ "kind": "Tokenizer.KW_MUT" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Type" }], "action": "makeMutFunctionParam" }
            ]
        },
        {
            "class": "FunctionParams",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "[$FunctionParam]", "split_by": { "kind": "Tokenizer.COMMA" }}], "action": "makeFunctionParams" }
            ]
        },
        {
            "class": "Field",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_VAR" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Type" }, { "kind": "Tokenizer.EQUAL" }, { "kind": "$Expression" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeFieldWithInitialValue" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_VAL" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Type" }, { "kind": "Tokenizer.EQUAL" }, { "kind": "$Expression" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeFieldWithInitialValue" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_VAR" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Type" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeField" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_VAL" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Type" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeField" }
            ]
        },
        {
            "class": "Function",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.ARROW" }, { "kind": "$Type" }, { "kind": "Tokenizer.EQUAL" }, { "kind": "$Expression" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeFunction" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.ARROW" }, { "kind": "$Type" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Expression" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeFunction" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.ARROW" }, { "kind": "$Type" }, { "kind": "$Block" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeFunctionFromBlock" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.ARROW" }, { "kind": "$Type" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeFunctionFromEmptyBlock" },

                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Expression" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeVoidFunction" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "$Block" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeVoidFunctionFromBlock" },
                { "patterns": [{ "optical_kind": "$Annotations" }, { "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_FUN" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeVoidFunctionFromEmptyBlock" }
            ]
        },
        {
            "class": "StructConstructor",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_CONSTRUCTOR" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "Tokenizer.COLON" }, { "kind": "$Expression" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeStructConstructor" },
                { "patterns": [{ "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_CONSTRUCTOR" }, { "kind": "Tokenizer.LEFT_PAREN" }, { "kind": "$FunctionParams" }, { "kind": "Tokenizer.RIGHT_PAREN" }, { "kind": "$Block" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeStructConstructorFromBlock" }
            ]
        },
        {
            "class": "Member",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "$Field" }], "action": "makeMemberFromField" },
                { "patterns": [{ "kind": "$Function" }], "action": "makeMemberFromFunction" },
                { "patterns": [{ "kind": "$StructConstructor" }], "action": "makeMemberFromStructConstructor" },
                { "patterns": [{ "kind": "$Struct" }], "action": "makeMemberFromStruct" }
            ]
        },
        {
            "class": "Struct",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "maybe_kind": "$ModifierList" }, { "kind": "Tokenizer.KW_STRUCT" }, { "kind": "Tokenizer.TK_IDENTIFIER" }, { "kind": "Tokenizer.LEFT_BRACE" }, { "kind": "[$Member]" }, { "kind": "Tokenizer.RIGHT_BRACE" }, { "kind": "Tokenizer.TK_LINE_TERMINATOR" }], "action": "makeStruct" }
            ]
        },
        {
            "class": "Program",
            "parser": "recursively-down",
            "sub_rules": [
                { "patterns": [{ "kind": "[$PreprocessSetting]" }, { "optical_kind": "$PackageDeclaration" }, { "optical_kind": "$ImportDeclarations" }, { "kind": "[$Member]" }], "action": "makeProgram" }
            ]
        }
    ],
    "others": [
        [   "private inline fun makeModifier(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val token: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    return new Modifier(token.text).addExtraToken(token)",
            "}" ],


        [   "private inline fun makeModifierList(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val parsedModifiers: pointer<ArrayList> = getContainerValue(results, 0) as pointer<ArrayList>",
            "    val modifiers: pointer<HashSet> = new HashSet(sizeof(Modifier), Modifier.equalModifier, Modifier.hashcode)",
            "",
            "    for (var i = 0; i < parsedModifiers.length; i++):",
            "        modifiers.add(getContainerValue(parsedModifiers, i) as pointer<Modifier>)",
            "",
            "    return modifiers",
            "}" ],


        [   "private inline fun makePreprocessSetting(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val hashToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "    val leftParen: pointer<Token> = getContainerValue(results, 2) as pointer<Token>",
            "    val value: pointer<ArrayList> = getContainerValue(results, 3) as pointer<ArrayList>",
            "    val rightParen: pointer<Token> = getContainerValue(results, 4) as pointer<Token>",
            "",
            "    return new PreprocessSetting(qualifiedName, value)",
            "        .addExtraToken(hashToken)",
            "        .addExtraToken(leftParen)",
            "        .addExtraToken(rightParen)",
            "}" ],


        [   "private inline fun makeAnnotation(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val atToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "",
            "    return new Annotation(qualifiedName).addExtraToken(atToken)",
            "}" ],


        [   "private inline fun makeAnnotationWithValues(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val atToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "    val leftParen: pointer<Token> = getContainerValue(results, 2) as pointer<Token>",
            "    val value: pointer<ArrayList> = getContainerValue(results, 3) as pointer<ArrayList>",
            "    val rightParen: pointer<Token> = getContainerValue(results, 4) as pointer<Token>",
            "",
            "    return new Annotation(qualifiedName, value)",
            "        .addExtraToken(atToken)",
            "        .addExtraToken(leftParen)",
            "        .addExtraToken(rightParen)",
            "}" ],


        [   "private inline fun makeAnnotations(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val parsedAnnotations: pointer<ArrayList> = getContainerValue(results, 0) as pointer<ArrayList>",
            "    val annotations: pointer<ArrayList> = new ArrayList(sizeof(Annotation))",
            "",
            "    for (var i = 0; i < parsedAnnotations.length; i++):",
            "        annotations.push(getContainerValue(parsedAnnotations, i) as pointer<Annotation>)",
            "",
            "    return annotations",
            "}" ],


        [   "private fun makeQualifiedName(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val firstNameToken: pointer<Token> =",
            "        getContainerValue(results, 0) as pointer<Token>",
            "    val parsedSuffixes: pointer<ArrayList> =",
            "        getContainerValue(results, 1) as pointer<ArrayList>",
            "    val qualifiedName: pointer<QualifiedName> =",
            "        new QualifiedName(firstNameToken.text)",
            "            .addExtraToken(firstNameToken)",
            "",
            "    for (var i: int = 0; i < parsedSuffixes.length; i++):",
            "    {",
            "        val suffix: pointer<ArrayList> =",
            "            getContainerValue(parsedSuffixes, i) as pointer<ArrayList>",
            "        val dotToken: pointer<Token> =",
            "            getContainerValue(suffix, 0) as pointer<Token>",
            "        val nameToken: pointer<Token> =",
            "            getContainerValue(suffix, 1) as pointer<Token>",
            "",
            "        qualifiedName.addExtraToken(dotToken)",
            "            .push(nameToken.text)",
            "            .addExtraToken(nameToken)",
            "    }",
            "",
            "    return qualifiedName",
            "}" ],



        [   "private inline fun makePackageDeclaration(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val packageToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "",
            "    return qualifiedName.toPackageDecl().addExtraToken(packageToken)",
            "}" ],


        [   "private inline fun makeNamespaceImport(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val importToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "",
            "    return NamespaceImport.fromSingle(qualifiedName).addExtraToken(importToken)",
            "}" ],


        [   "private inline fun makeAllNamespaceImport(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val importToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "    val dotToken: pointer<Token> = getContainerValue(results, 2) as pointer<Token>",
            "    val starToken: pointer<Token> = getContainerValue(results, 3) as pointer<Token>",
            "",
            "    return NamespaceImport.fromAll(qualifiedName)",
            "        .addExtraToken(importToken)",
            "        .addExtraToken(dotToken)",
            "        .addExtraToken(starToken)",
            "}" ],


        [   "private inline fun makeImportFromNamespace(results: pointer<ArrayList>) -> pointer<*> =",
            "    ImportDeclaration.fromNamespace(getContainerValue(results, 0) as pointer<NamespaceImport>)" ],


        [   "private inline fun makeImportFromSelective(results: pointer<ArrayList>) -> pointer<*> =",
            "    ImportDeclaration.fromSelective(getContainerValue(results, 0) as pointer<SelectiveImports>)" ],


        [   "private inline fun makeImportedFunction(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val nameToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val parsedTypes: pointer<ArrayList> = getContainerValue(results, 2) as pointer<ArrayList>",
            "    val aliasName: pointer<char> = getContainerValue(results, 4) as pointer<char>",
            "    val parameterTypes: pointer<ArrayList> = new ArrayList(sizeof(Type))",
            "",
            "    for (var i = 0; i < parsedTypes.length; i++):",
            "        parameterTypes.push(getContainerValue(parsedTypes, i) as pointer<Type>)",
            "",
            "    return ImportedSymbol.fromFunction(nameToken.text, parameterTypes, aliasName)",
            "}" ],


        [   "private inline fun makeImportedVariable(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val nameToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
            "    val aliasName: pointer<char> = getContainerValue(results, 1) as pointer<char>",
            "",
            "    return ImportedSymbol.fromVariable(nameToken.text, aliasName)",
            "}" ],


        [   "private inline fun makeImportedSymbolAlias(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val aliasToken: pointer<Token> = getContainerValue(results, 1) as pointer<Token>",
            "    return aliasToken.text",
            "}" ],


        [   "private inline fun makeAllSelectiveImport(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "",
            "    return SelectiveImports.fromAll(qualifiedName)",
            "}" ],


        [   "private inline fun makeSelectiveImport(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "    val importedFunction: pointer<ImportedSymbol> = getContainerValue(results, 3) as pointer<ImportedSymbol>",
            "    val importedFunctions: pointer<ArrayList> = new ArrayList(sizeof(ImportedSymbol))",
            "",
            "    importedFunctions.push(importedFunction)",
            "    return SelectiveImports.fromCertain(qualifiedName, importedFunctions)",
            "}" ],


        [   "private inline fun makeSelectiveImports(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val qualifiedName: pointer<QualifiedName> = getContainerValue(results, 1) as pointer<QualifiedName>",
            "    val parsedFunctions: pointer<ArrayList> = getContainerValue(results, 4) as pointer<ArrayList>",
            "    val importedFunctions: pointer<ArrayList> = new ArrayList(sizeof(ImportedSymbol))",
            "",
            "    for (var i = 0; i < parsedFunctions.length; i++):",
            "        importedFunctions.push(getContainerValue(parsedFunctions, i) as pointer<ImportedSymbol>)",
            "",
            "    return SelectiveImports.fromCertain(qualifiedName, importedFunctions)",
            "}" ],


        [   "private inline fun makeImportDeclarations(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val parsedImports: pointer<ArrayList> = getContainerValue(results, 0) as pointer<ArrayList>",
            "    val imports: pointer<ArrayList> = new ArrayList(sizeof(ImportDeclaration))",
            "",
            "    for (var i = 0; i < parsedImports.length; i++):",
            "        imports.push(getContainerValue(parsedImports, i) as pointer<ImportDeclaration>)",
            "",
            "    return imports",
            "}" ],


        [   "private inline fun makeFunctionParam(results: pointer<ArrayList>) -> pointer<*>",
            "{",
            "    val nameToken: pointer<Token> = getContainerValue(results, 0) as pointer<Token>",
